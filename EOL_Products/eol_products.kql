// =====================================================================================
// End-of-Life (EOL) hunting — endoflife.date  ->  Microsoft Defender XDR
// Data: EOL_Products/eol_products.csv  (built from https://endoflife.date/ v1 API)
// Categories: os, database, app.   See README.md for column meanings & caveats.
//
// Every query below is SELF-CONTAINED: it declares its own `let eol = externaldata(...)`
// so you can copy a single block into Advanced Hunting and run it as-is.
// =====================================================================================


// #####################################################################################
// CASE 1 — Applications & databases ALREADY past end-of-life
// Join DeviceTvmSoftwareInventory on vendor + software name (both lower-cased from CPE).
// #####################################################################################
let eol = externaldata(category:string, product_id:string, product:string, release:string,
    release_date:string, eol_date:string, is_eol:string, is_maintained:string,
    latest_version:string, cpe:string, defender_vendor:string, defender_softwarename:string,
    aliases:string)
    [@"https://raw.githubusercontent.com/Sergio-Albea-Git/Threat-Hunting-KQL-Queries/main/EOL_Products/eol_products.csv"]
    with (format="csv", ignoreFirstRecord=true);
DeviceTvmSoftwareInventory
| where isnotempty(SoftwareVendor) and isnotempty(SoftwareName)
| join kind=inner (
    eol
    | where category in ("app", "database")
    | where isnotempty(defender_vendor) and isnotempty(eol_date)
    | extend eolDate = todatetime(eol_date)
    | where eolDate < now()
) on $left.SoftwareVendor == $right.defender_vendor,
     $left.SoftwareName == $right.defender_softwarename
| project DeviceName, SoftwareVendor, SoftwareName, SoftwareVersion,
          Category = category, EOL_Release = release, EOL_Date = eol_date,
          Latest = latest_version
| sort by EOL_Date asc


// #####################################################################################
// CASE 2 — Applications & databases reaching end-of-life within the NEXT 90 DAYS
// Early-warning list so you can plan upgrades before support ends.
// #####################################################################################
let eol = externaldata(category:string, product_id:string, product:string, release:string,
    release_date:string, eol_date:string, is_eol:string, is_maintained:string,
    latest_version:string, cpe:string, defender_vendor:string, defender_softwarename:string,
    aliases:string)
    [@"https://raw.githubusercontent.com/Sergio-Albea-Git/Threat-Hunting-KQL-Queries/main/EOL_Products/eol_products.csv"]
    with (format="csv", ignoreFirstRecord=true);
DeviceTvmSoftwareInventory
| where isnotempty(SoftwareVendor) and isnotempty(SoftwareName)
| join kind=inner (
    eol
    | where category in ("app", "database")
    | where isnotempty(defender_vendor) and isnotempty(eol_date)
    | extend eolDate = todatetime(eol_date)
    | where eolDate between (now() .. now() + 90d)
) on $left.SoftwareVendor == $right.defender_vendor,
     $left.SoftwareName == $right.defender_softwarename
| extend DaysLeft = datetime_diff('day', eolDate, now())
| project DeviceName, SoftwareVendor, SoftwareName, SoftwareVersion,
          EOL_Release = release, EOL_Date = eol_date, DaysLeft, Latest = latest_version
| sort by DaysLeft asc


// #####################################################################################
// CASE 3 — Most precise match: exact CPE prefix (vendor:product)
// Use when Defender has populated ProductCodeCpe. Works for app / database / os rows.
// #####################################################################################
let eol = externaldata(category:string, product_id:string, product:string, release:string,
    release_date:string, eol_date:string, is_eol:string, is_maintained:string,
    latest_version:string, cpe:string, defender_vendor:string, defender_softwarename:string,
    aliases:string)
    [@"https://raw.githubusercontent.com/Sergio-Albea-Git/Threat-Hunting-KQL-Queries/main/EOL_Products/eol_products.csv"]
    with (format="csv", ignoreFirstRecord=true);
DeviceTvmSoftwareInventory
| where isnotempty(ProductCodeCpe) and ProductCodeCpe != "not available"
| extend cpe_key = strcat(tostring(split(ProductCodeCpe, ":")[3]), ":", tostring(split(ProductCodeCpe, ":")[4]))
| join kind=inner (
    eol
    | where isnotempty(defender_vendor) and isnotempty(eol_date)
    | extend cpe_key = strcat(defender_vendor, ":", defender_softwarename)
    | extend eolDate = todatetime(eol_date)
    | where eolDate < now()
) on cpe_key
| project DeviceName, ProductCodeCpe, Product = product, Release = release,
          EOL_Date = eol_date, Latest = latest_version
| sort by EOL_Date asc


// #####################################################################################
// CASE 4 — OPERATING SYSTEMS: full lifecycle status for every device
// Matches how Defender represents the OS in DeviceInfo:
//   Windows client  -> OSPlatform (Windows10/Windows11) + OSVersionInfo (22H2, 24H2, 1607)
//   Windows Server  -> OSPlatform (WindowsServer2019/2022...)   [LTSC channel]
//   macOS           -> OSVersion major (26 Tahoe, 15 Sequoia, 14 Sonoma, 13 Ventura)
//   iOS / Android   -> OSVersion major (26, 18 / 16, 15)
// A normalized `os_key` is built on both sides and joined.
// #####################################################################################
let eol = externaldata(category:string, product_id:string, product:string, release:string,
    release_date:string, eol_date:string, is_eol:string, is_maintained:string,
    latest_version:string, cpe:string, defender_vendor:string, defender_softwarename:string,
    aliases:string)
    [@"https://raw.githubusercontent.com/Sergio-Albea-Git/Threat-Hunting-KQL-Queries/main/EOL_Products/eol_products.csv"]
    with (format="csv", ignoreFirstRecord=true);
let eol_os =
    eol
    | where category == "os"
    | extend eolDate = todatetime(eol_date)
    // keep the mainstream consumer/GA channel for Windows client, LTSC for Server
    | extend os_key = case(
        product_id == "windows" and release !contains "(E)" and release !contains "IoT" and release !contains "LTS",
            strcat("win|",     extract(@"^(1[01]\s+\w+)", 1, release)),          // "10 22H2", "11 24H2"
        product_id == "windows-server" and release contains "LTSC",
            strcat("winsrv|",  extract(@"Windows Server (\d{4})", 1, release)),  // "2019", "2022"
        product_id == "macos",
            strcat("mac|",     extract(@"(?:macOS|OS X|Mac OS X)\s+(\d+)", 1, release)), // "26","15","14","13"
        product_id == "ios",
            strcat("ios|",     extract(@"^(\d+)", 1, release)),                  // "26","18"
        product_id == "android",
            strcat("android|", extract(@"^(\d+)", 1, release)),                  // "16","15"
        "")
    | where isnotempty(os_key) and not(os_key endswith "|");
DeviceInfo
| where isnotempty(OSPlatform)
| summarize arg_max(Timestamp, OSVersion, OSVersionInfo) by DeviceId, DeviceName, OSPlatform
| extend os_family = case(
        OSPlatform startswith "WindowsServer", "winsrv",
        OSPlatform startswith "Windows",       "win",
        OSPlatform =~ "macOS",                 "mac",
        OSPlatform =~ "iOS",                   "ios",
        OSPlatform =~ "Android",               "android",
        "other")
| extend os_key = case(
        os_family == "winsrv",  strcat("winsrv|",  extract(@"(\d{4})", 1, OSPlatform)),
        os_family == "win",     strcat("win|",     extract(@"(\d+)$", 1, OSPlatform), " ", OSVersionInfo),
        os_family == "mac",     strcat("mac|",     tostring(split(OSVersion, ".")[0])),
        os_family == "ios",     strcat("ios|",     tostring(split(OSVersion, ".")[0])),
        os_family == "android", strcat("android|", tostring(split(OSVersion, ".")[0])),
        "")
| where isnotempty(os_key) and os_family != "other"
| join kind=leftouter eol_os on os_key
| extend Status = case(
        isempty(eol_date),        "no published EOL date (still supported / unknown)",
        eolDate < now(),          "END OF LIFE",
        eolDate <= now() + 180d,  "EOL within 180 days",
                                  "supported")
| extend DaysToEOL = iff(isnotempty(eol_date), datetime_diff('day', eolDate, now()), long(null))
| project DeviceName, OSPlatform, OSVersion, OSVersionInfo,
          Matched = product, EOL_Release = release, EOL_Date = eol_date,
          Status, DaysToEOL, LastSeen = Timestamp
| sort by Status asc, DaysToEOL asc


// #####################################################################################
// CASE 5 — OPERATING SYSTEMS already past end-of-life (devices to remediate now)
// Same OS normalization as CASE 4, filtered to EOL only, counted by OS version.
// #####################################################################################
let eol = externaldata(category:string, product_id:string, product:string, release:string,
    release_date:string, eol_date:string, is_eol:string, is_maintained:string,
    latest_version:string, cpe:string, defender_vendor:string, defender_softwarename:string,
    aliases:string)
    [@"https://raw.githubusercontent.com/Sergio-Albea-Git/Threat-Hunting-KQL-Queries/main/EOL_Products/eol_products.csv"]
    with (format="csv", ignoreFirstRecord=true);
let eol_os =
    eol
    | where category == "os" and isnotempty(eol_date)
    | extend eolDate = todatetime(eol_date)
    | extend os_key = case(
        product_id == "windows" and release !contains "(E)" and release !contains "IoT" and release !contains "LTS",
            strcat("win|",     extract(@"^(1[01]\s+\w+)", 1, release)),
        product_id == "windows-server" and release contains "LTSC",
            strcat("winsrv|",  extract(@"Windows Server (\d{4})", 1, release)),
        product_id == "macos",
            strcat("mac|",     extract(@"(?:macOS|OS X|Mac OS X)\s+(\d+)", 1, release)),
        product_id == "ios",
            strcat("ios|",     extract(@"^(\d+)", 1, release)),
        product_id == "android",
            strcat("android|", extract(@"^(\d+)", 1, release)),
        "")
    | where isnotempty(os_key) and not(os_key endswith "|") and eolDate < now();
DeviceInfo
| where isnotempty(OSPlatform)
| summarize arg_max(Timestamp, OSVersion, OSVersionInfo) by DeviceId, DeviceName, OSPlatform
| extend os_family = case(
        OSPlatform startswith "WindowsServer", "winsrv",
        OSPlatform startswith "Windows",       "win",
        OSPlatform =~ "macOS",                 "mac",
        OSPlatform =~ "iOS",                   "ios",
        OSPlatform =~ "Android",               "android",
        "other")
| extend os_key = case(
        os_family == "winsrv",  strcat("winsrv|",  extract(@"(\d{4})", 1, OSPlatform)),
        os_family == "win",     strcat("win|",     extract(@"(\d+)$", 1, OSPlatform), " ", OSVersionInfo),
        os_family == "mac",     strcat("mac|",     tostring(split(OSVersion, ".")[0])),
        os_family == "ios",     strcat("ios|",     tostring(split(OSVersion, ".")[0])),
        os_family == "android", strcat("android|", tostring(split(OSVersion, ".")[0])),
        "")
| where os_family != "other" and isnotempty(os_key)
| join kind=inner eol_os on os_key
| summarize Devices = dcount(DeviceId), Sample = make_set(DeviceName, 5)
        by OSPlatform, OSVersion, OSVersionInfo, Matched = product, EOL_Release = release, EOL_Date = eol_date
| sort by Devices desc


// #####################################################################################
// CASE 6 — OPERATING SYSTEMS reaching end-of-life within the NEXT 180 DAYS
// Plan OS upgrades before support ends.
// #####################################################################################
let eol = externaldata(category:string, product_id:string, product:string, release:string,
    release_date:string, eol_date:string, is_eol:string, is_maintained:string,
    latest_version:string, cpe:string, defender_vendor:string, defender_softwarename:string,
    aliases:string)
    [@"https://raw.githubusercontent.com/Sergio-Albea-Git/Threat-Hunting-KQL-Queries/main/EOL_Products/eol_products.csv"]
    with (format="csv", ignoreFirstRecord=true);
let eol_os =
    eol
    | where category == "os" and isnotempty(eol_date)
    | extend eolDate = todatetime(eol_date)
    | extend os_key = case(
        product_id == "windows" and release !contains "(E)" and release !contains "IoT" and release !contains "LTS",
            strcat("win|",     extract(@"^(1[01]\s+\w+)", 1, release)),
        product_id == "windows-server" and release contains "LTSC",
            strcat("winsrv|",  extract(@"Windows Server (\d{4})", 1, release)),
        product_id == "macos",
            strcat("mac|",     extract(@"(?:macOS|OS X|Mac OS X)\s+(\d+)", 1, release)),
        product_id == "ios",
            strcat("ios|",     extract(@"^(\d+)", 1, release)),
        product_id == "android",
            strcat("android|", extract(@"^(\d+)", 1, release)),
        "")
    | where isnotempty(os_key) and not(os_key endswith "|")
    | where eolDate between (now() .. now() + 180d);
DeviceInfo
| where isnotempty(OSPlatform)
| summarize arg_max(Timestamp, OSVersion, OSVersionInfo) by DeviceId, DeviceName, OSPlatform
| extend os_family = case(
        OSPlatform startswith "WindowsServer", "winsrv",
        OSPlatform startswith "Windows",       "win",
        OSPlatform =~ "macOS",                 "mac",
        OSPlatform =~ "iOS",                   "ios",
        OSPlatform =~ "Android",               "android",
        "other")
| extend os_key = case(
        os_family == "winsrv",  strcat("winsrv|",  extract(@"(\d{4})", 1, OSPlatform)),
        os_family == "win",     strcat("win|",     extract(@"(\d+)$", 1, OSPlatform), " ", OSVersionInfo),
        os_family == "mac",     strcat("mac|",     tostring(split(OSVersion, ".")[0])),
        os_family == "ios",     strcat("ios|",     tostring(split(OSVersion, ".")[0])),
        os_family == "android", strcat("android|", tostring(split(OSVersion, ".")[0])),
        "")
| where os_family != "other" and isnotempty(os_key)
| join kind=inner eol_os on os_key
| extend DaysToEOL = datetime_diff('day', eolDate, now())
| project DeviceName, OSPlatform, OSVersion, OSVersionInfo,
          Matched = product, EOL_Release = release, EOL_Date = eol_date, DaysToEOL
| sort by DaysToEOL asc
